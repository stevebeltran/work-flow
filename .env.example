# HubSpot Private App Token
# Create at: app.hubspot.com → Account Settings → Integrations → Private Apps
HUBSPOT_PRIVATE_APP_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Jira Cloud credentials
# API token: id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_USER_EMAIL=you@brincdrones.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=OB

# Google Doc template — copied and filled in per new customer
# Share the doc with your service account email (Editor access)
GOOGLE_DOC_TEMPLATE_ID=1ck0bOuD9BN6pUWfyJLjlslj_5roGszpd

# Google Sheets
# Sheet ID is the long string in the Google Sheets URL
GOOGLE_SHEET_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ
GOOGLE_SA_JSON_PATH=credentials/google_service_account.json

# Email notifications via Gmail SMTP (optional — leave blank to disable)
# Setup: Google Account → Security → App Passwords → generate one for "Mail"
# NOTIFY_EMAIL_TO supports multiple recipients: you@example.com,other@example.com
NOTIFY_EMAIL_SENDER=you@gmail.com
NOTIFY_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
NOTIFY_EMAIL_TO=ops@brincdrones.com
NOTIFY_EMAIL_SMTP_HOST=smtp.gmail.com
NOTIFY_EMAIL_SMTP_PORT=587
